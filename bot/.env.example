# Copia questo file in ".env" e compila il token. NON condividere mai il file .env.
DISCORD_TOKEN=INCOLLA_QUI_IL_TOKEN_DEL_BOT

# --- Assistenza vocale (attesa) ---
VOICE_CHANNEL_ID=1561411924225429595
STAFF_ROLE_ID=1561050593018249356

# Gli ID di ruoli e canali dei comandi sono già dentro config.js.
# Se vuoi cambiarne uno senza toccare il codice, scrivilo qui, ad esempio:
# RUOLO_ASSISTENZA=123456789
# CANALE_LOG_WARN=123456789

# Metti "si" solo se hai attivato "Message Content Intent" nel Developer Portal:
# serve per avere il testo dei messaggi nelle trascrizioni dei ticket.
MESSAGE_CONTENT=no
